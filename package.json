{
  "name": "gmgn-signal-bot",
  "version": "0.1.0",
  "description": "GMGN.ai memecoin signal bot Chrome Extension - automated real-time trading signal generation for Solana memecoin trading",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run --no-watch",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --no-watch",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "groq-sdk": "0.18.0",
    "preact": "10.29.0",
    "wxt": "0.20.17",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.3",
    "@testing-library/preact": "3.2.4",
    "@types/chrome": "latest",
    "happy-dom": "20.8.4",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
