# Environment template for the trade-read server.
#
# The server package's `start` and `dev` scripts run with the package directory as their working
# directory, so put the file there (`cp .env.example server/.env`); `.env` is gitignored wherever
# it sits and Node's built-in `--env-file` reads it. Exporting the same names in your shell works
# equally well. There is no dotenv dependency anywhere in the build.
#
# Every variable below is read by server/src/config/env.ts, and no other environment variable
# is read, so a name added here needs its parser change first. A blank value is treated as
# unset, which is why the optional entries are present with no value.

# The only model credential. When unset, GET /api/v1/health reports providerConfigured: false
# and every submission returns 503 PROVIDER_NOT_CONFIGURED. Never put a real value here.
OPENROUTER_API_KEY=

# The single vision-capable slug used for both the extraction and the synthesis call.
OPENROUTER_MODEL=google/gemini-2.5-flash

# The single model egress base; the adapter appends /chat/completions to it.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution: sent as the HTTP-Referer header when set.
OPENROUTER_REFERER=

# Optional attribution: sent as the X-Title header when set.
OPENROUTER_APP_TITLE=

# Where analysis documents and submitted image bytes are written (gitignored); deleting an
# analysis removes both.
DATA_DIR=.data

# API port.
PORT=3001

# Bind address. Loopback is the required default; set it explicitly to listen elsewhere.
HOST=127.0.0.1

# Set to 1 to replay recorded provider responses instead of calling OpenRouter, so no
# credential and no network are needed.
STUB_PROVIDER=
