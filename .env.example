# === Database Configuration ===
DATABASE_URL=postgresql://trading:trading_password@localhost:5432/trading_intelligence
# For Supabase: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_PROVIDER=local

# === Redis Configuration ===
REDIS_URL=redis://localhost:6379

# === OpenRouter LLM Configuration ===
OPENROUTER_API_KEY=sk-or-...your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model IDs for each pipeline stage
FILTER_MODEL=deepseek/deepseek-v3-0324
SENTIMENT_MODEL=anthropic/claude-haiku-4-5-20241022
TRADE_DETECT_MODEL=anthropic/claude-haiku-4-5-20241022
RECOMMEND_MODEL=anthropic/claude-sonnet-4-6-20250514

# === Telegram Bot Configuration ===
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# === External API Keys ===
FINNHUB_API_KEY=your-finnhub-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
COINGECKO_API_KEY=your-coingecko-api-key
CRYPTOCOMPARE_API_KEY=your-cryptocompare-api-key

# === Application Configuration ===
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug

# === Queue Configuration ===
NEWS_POLL_INTERVAL=*/5 * * * *
ANALYSIS_CONCURRENCY=3
NOTIFICATION_CONCURRENCY=5

# === RSS Feed URLs (Indian Markets) ===
RSS_ECONOMIC_TIMES=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms
RSS_FINANCIAL_EXPRESS=https://www.financialexpress.com/market/feed/
RSS_BUSINESS_STANDARD=https://www.business-standard.com/rss/markets-106.rss
