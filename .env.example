# ============================================================================
# GMGN Signal Bot — Chrome Extension API Keys Configuration
# ============================================================================
#
# Copy this file to `.env` and fill in your API keys:
#
#   cp .env.example .env
#
# NOTE: API keys are entered via the extension's Settings panel at runtime.
# These environment variables are for development and build-time use only.
#
# ---------------------------------------------------------------------------
# COST SUMMARY
# ---------------------------------------------------------------------------
# Total estimated monthly cost: ~$150-250
#   - Birdeye Starter plan:     $99/mo
#   - Helius Developer plan:    $49/mo
#   - LLM usage (Groq + Claude): $5-15/mo
#
# FREE-TIER APIs (no API key required):
#   - PumpPortal  — WebSocket for new pump.fun token events (wss://pumpportal.fun/api/data)
#   - Jupiter     — Price quotes and honeypot simulation (https://price.jup.ag)
#   - DexScreener — Fallback token data (https://api.dexscreener.com)
#   - GoPlus      — Solana token security checks (https://api.gopluslabs.io)
# ============================================================================

# ---------------------------------------------------------------------------
# Birdeye — Token Analytics
# ---------------------------------------------------------------------------
# Starter plan recommended ($99/mo). Get your key from: https://birdeye.so
# Base URL: https://public-api.birdeye.so
# Auth: X-API-KEY header
# Used for: token price, OHLCV, transactions, top holders, WebSocket streams
# Rate limit: 15-100 RPS depending on plan
BIRDEYE_API_KEY=

# ---------------------------------------------------------------------------
# Helius — Enhanced Solana RPC
# ---------------------------------------------------------------------------
# Developer plan recommended ($49/mo). Get your key from: https://helius.xyz
# Base URL: https://api.helius.xyz
# Auth: API key in URL path
# Used for: enhanced transaction parsing, parsed wallet activity, token metadata
# Rate limit: ~10 RPS on Developer plan
HELIUS_API_KEY=

# ---------------------------------------------------------------------------
# RugCheck — Token Safety Reports
# ---------------------------------------------------------------------------
# Free tier available. Get your key from: https://rugcheck.xyz
# Base URL: https://api.rugcheck.xyz
# Auth: X-API-KEY header
# Used for: token safety reports (/tokens/{id}/report), insider detection (/tokens/{id}/insiders/graph)
RUGCHECK_API_KEY=

# ---------------------------------------------------------------------------
# Groq — LLM Inference (Three-Tier AI Analysis)
# ---------------------------------------------------------------------------
# Free tier with daily token limits. Get your key from: https://groq.com
# Base URL: https://api.groq.com
# Auth: Authorization: Bearer header
# Used for: three-tier AI analysis routing
#   - Tier 1 (80% of calls): llama-3.1-8b-instant — routine screening
#   - Tier 2 (15% of calls): llama-3.3-70b-versatile — detailed analysis
# Supports structured JSON output via response_format: { type: 'json_object' }
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Anthropic Claude — Premium Narrative Analysis
# ---------------------------------------------------------------------------
# Pay-per-use pricing. Get your key from: https://anthropic.com
# Base URL: https://api.anthropic.com
# Auth: x-api-key header
# Used for: narrative analysis of top 5% highest-confidence signals (Tier 3)
# Optional — only needed for premium tier analysis; the bot functions without it
ANTHROPIC_API_KEY=
