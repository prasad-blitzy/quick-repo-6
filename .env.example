# ============================================================================
# Trading Intelligence Application — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your API keys and configuration values.
#
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set before the application can start.
# Variables marked [OPTIONAL] have sensible defaults or are only needed for
# specific features.
# ============================================================================


# === Database Configuration ===
# PostgreSQL connection string used by Drizzle ORM.
# The default value matches the docker-compose.yml PostgreSQL 16 service.
DATABASE_URL=postgresql://trading:trading_password@localhost:5432/trading_intelligence

# For Supabase, replace DATABASE_URL with your project's pooler connection string:
# DATABASE_URL=postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# NOTE: Supabase's pgBouncer transaction pooler requires Drizzle to use prepare: false.

# Toggle between "local" (pg driver) and "supabase" (postgres driver with prepare: false).
# This controls which PostgreSQL driver and connection options Drizzle ORM uses.
# See AAP Rule 0.7.4 for seamless switching between local PostgreSQL and Supabase.
# [REQUIRED] — Accepted values: "local" | "supabase"
DATABASE_PROVIDER=local


# === Redis Configuration ===
# Redis 7 connection string used by BullMQ for job queues.
# The default value matches the docker-compose.yml Redis 7 service.
# [REQUIRED]
REDIS_URL=redis://localhost:6379


# === OpenRouter LLM Configuration ===
# OpenRouter provides a unified LLM gateway. All AI analysis pipeline calls
# are routed through OpenRouter using @langchain/openai ChatOpenAI with a
# custom baseURL.
# Get your API key at: https://openrouter.ai/keys

# [REQUIRED] — Your OpenRouter API key (starts with sk-or-)
OPENROUTER_API_KEY=sk-or-...your-key-here

# OpenRouter API base URL. Rarely needs to be changed.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model IDs for each stage of the four-stage LangGraph analysis pipeline.
# Each stage uses a different model tier to optimize cost vs. quality.
# All models use temperature=0 for deterministic financial analysis.

# Stage 1 — Filtering: Binary relevance classification (high volume, cheap model)
# DeepSeek V3.2 — $0.25/$0.38 per 1M tokens (input/output)
FILTER_MODEL=deepseek/deepseek-v3-0324

# Stage 2 — Sentiment: Nuanced financial sentiment analysis
# Claude Haiku 4.5 — $1.00/$5.00 per 1M tokens (input/output)
SENTIMENT_MODEL=anthropic/claude-haiku-4-5-20241022

# Stage 3 — Trade Detection: Identifies actionable trade opportunities
# Claude Haiku 4.5 — $1.00/$5.00 per 1M tokens (input/output)
TRADE_DETECT_MODEL=anthropic/claude-haiku-4-5-20241022

# Stage 4 — Recommendation: Generates structured trade recommendations
# Only ~25% of articles reach this expensive stage (conditional short-circuiting)
# Claude Sonnet 4.6 — $3.00/$15.00 per 1M tokens (input/output)
RECOMMEND_MODEL=anthropic/claude-sonnet-4-6-20250514


# === Telegram Bot Configuration ===
# grammY-based Telegram bot for trade alert delivery and user preference management.
# Create a bot via @BotFather on Telegram to obtain your token.
# Commands: /start (register), /settings (preferences), /status (system health)
#
# [OPTIONAL] — When omitted, the Telegram bot is disabled and the Express
# REST API operates independently. Trade alerts will not be delivered via
# Telegram, but the web dashboard, queue processing, and AI pipeline function normally.
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather


# === External API Keys ===
# API keys for financial data sources. Each source has its own Bottleneck rate
# limiter instance configured to its specific free-tier limits.

# Finnhub — US stock news and real-time quotes
# Free tier: 60 API calls/minute
# Get your key at: https://finnhub.io/register
# [REQUIRED]
FINNHUB_API_KEY=your-finnhub-api-key

# Alpha Vantage — Historical price data and NEWS_SENTIMENT endpoint
# Free tier: 25 API calls/day
# Get your key at: https://www.alphavantage.co/support/#api-key
# [REQUIRED]
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# CoinGecko — Crypto trending coins and market data
# Free tier: 30 API calls/minute (Demo API key optional for higher limits)
# Get your key at: https://www.coingecko.com/en/api/pricing
# [OPTIONAL] — Free tier works without a key; set for higher rate limits
COINGECKO_API_KEY=your-coingecko-api-key

# CryptoCompare — Crypto news and historical OHLCV data
# Free tier: 100,000 API calls/month
# Get your key at: https://min-api.cryptocompare.com/
# [REQUIRED]
CRYPTOCOMPARE_API_KEY=your-cryptocompare-api-key

# NOTE: The following data sources do NOT require API keys:
# - Binance REST API (public endpoints for crypto klines and ticker prices)
# - stock-nse-india (web scraper for NSE India equity quotes)
# - RSS Feeds (public feeds for Indian market and US financial news)
# - Reddit RSS (public RSS feeds for r/wallstreetbets, r/IndianStreetBets)


# === Bull Board Queue Dashboard ===
# Password for HTTP Basic Auth on the /admin/queues queue management dashboard.
# When set, access requires username "admin" and this password.
# When unset in production, the dashboard is disabled entirely (security by default).
# When unset in development, the dashboard is open without auth.
# [OPTIONAL] — Strongly recommended for production deployments.
# BULL_BOARD_PASSWORD=your-secure-password-here


# === Application Configuration ===
# Core Express server and runtime settings.

# Node.js environment. Controls logging format, error detail, and optimizations.
# Accepted values: "development" | "production" | "test"
NODE_ENV=development

# Express HTTP server port. The API serves REST endpoints and Bull Board dashboard.
# [REQUIRED]
PORT=3000

# Frontend URL for CORS origin whitelist. Must match the Vite dev server address
# in development or the deployed frontend URL in production.
FRONTEND_URL=http://localhost:5173

# Pino structured logger level. Controls minimum severity of log output.
# Accepted values: "trace" | "debug" | "info" | "warn" | "error" | "fatal"
# In production, use "info" or "warn" to reduce log volume.
LOG_LEVEL=debug


# === Queue Configuration ===
# BullMQ queue settings for the three-queue job infrastructure (Redis-backed).
# See AAP Rule 0.7.6 for queue architecture details.

# Cron expression for the news-polling repeatable job.
# Default: every 5 minutes. Format: standard cron (minute hour day month weekday).
NEWS_POLL_INTERVAL=*/5 * * * *

# Maximum concurrent analysis pipeline jobs. Controls parallelism for LangGraph
# pipeline execution. Keep low to respect OpenRouter rate limits.
# [OPTIONAL] — Default: 3
ANALYSIS_CONCURRENCY=3

# Maximum concurrent Telegram notification sends. Controls parallelism for
# the notification dispatch worker (Telegram limit: 30 messages/second).
# [OPTIONAL] — Default: 5
NOTIFICATION_CONCURRENCY=5


# === RSS Feed URLs (Indian Markets & Financial News) ===
# RSS/Atom feed URLs for Indian equity market news ingestion.
# These are parsed by the rss-parser npm package on each polling cycle.

# Economic Times — Markets section RSS feed
RSS_ECONOMIC_TIMES=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms

# Financial Express — Market news feed
RSS_FINANCIAL_EXPRESS=https://www.financialexpress.com/market/feed/

# Business Standard — Markets section RSS feed
RSS_BUSINESS_STANDARD=https://www.business-standard.com/rss/markets-106.rss
