{
  "name": "@trade-read/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b --watch --preserveWatchOutput",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "sh -c 'if [ -f .env ]; then exec node --watch --env-file=.env dist/index.js; else exec node --watch dist/index.js; fi'",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@trade-read/shared": "*",
    "express": "^5.1",
    "multer": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
