{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run --no-watch",
    "clean": "rm -rf dist",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@trading-intelligence/types": "workspace:*",
    "@trading-intelligence/utils": "workspace:*",
    "express": "^4.21.0",
    "grammy": "^1.41.1",
    "drizzle-orm": "^0.45.1",
    "bullmq": "^5.71.0",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/openai": "^1.2.13",
    "@langchain/core": "^1.1.32",
    "zod-to-json-schema": "^3.25.0",
    "pino": "^10.3.1",
    "pino-http": "^10.0.0",
    "zod": "^3.25.32",
    "pg": "^8.13.0",
    "postgres": "^3.4.0",
    "ioredis": "^5.6.0",
    "bottleneck": "^2.19.5",
    "rss-parser": "^3.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "helmet": "^8.0.0",
    "@bull-board/api": "^6.19.0",
    "@bull-board/express": "^6.20.3",
    "stock-nse-india": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "drizzle-kit": "^0.30.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "pino-pretty": "^13.1.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.0.0",
    "@types/cors": "^2.8.0",
    "@types/node": "^22.0.0"
  }
}
