{
  "name": "@trading-intelligence/api",
  "version": "0.1.0",
  "private": true,
  "description": "Trading Intelligence Application — Express backend with AI-powered analysis pipeline, Telegram bot, and BullMQ job queues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bull-board/api": "^6.19.0",
    "@bull-board/express": "^6.20.3",
    "@langchain/core": "^1.1.32",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/openai": "^1.2.13",
    "@trading-intelligence/types": "workspace:*",
    "@trading-intelligence/utils": "workspace:*",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.71.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.0",
    "grammy": "^1.41.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-http": "^10.0.0",
    "postgres": "^3.4.0",
    "rss-parser": "^3.13.0",
    "stock-nse-india": "^1.3.0",
    "zod": "^3.25.32",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
