{
  "name": "@trading-intelligence/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript type definitions for Trading Intelligence Application",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "typescript": "~5.9.0"
  }
}
