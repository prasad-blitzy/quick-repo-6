{
  "name": "@trading-intelligence/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared formatting and validation utilities for Trading Intelligence Application",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@trading-intelligence/types": "workspace:*",
    "date-fns": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "~5.9.0"
  }
}
